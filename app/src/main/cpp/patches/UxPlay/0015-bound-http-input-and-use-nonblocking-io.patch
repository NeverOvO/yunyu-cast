+static void
+httpd_read_data(httpd_t *httpd, http_connection_t *connection, const char *data, int datalen)
+{
+    int offset = 0;
+    while (offset < datalen && connection->connected && !connection->pending_remove) {
+        MUTEX_LOCK(httpd->run_mutex);
+        int running = httpd->running;
+        MUTEX_UNLOCK(httpd->run_mutex);
+        if (!running) {
+            return;
+        }
+        /* Replies to /event on a PTTH channel are consumed without accumulating
+           a request body or passing response syntax to the request parser. */
+        if (connection->reverse_stream || connection->type == CONNECTION_TYPE_PTTH) {
+            connection->reverse_stream = true;
+            connection->request_started_ms = 0;
+            return;
+        }
+        if (!connection->prefix_checked) {
+            if (!connection->request_started_ms) {
+                connection->request_started_ms = httpd_now_ms();
+            }
+            size_t needed = sizeof(connection->prefix) - connection->prefix_length;
+            size_t available = (size_t) (datalen - offset);
+            size_t take = needed < available ? needed : available;
+            memcpy(connection->prefix + connection->prefix_length, data + offset, take);
+            connection->prefix_length += take;
+            offset += (int) take;
+            if (connection->prefix_length < sizeof(connection->prefix)) {
+                return; /* The next readable event supplies the remaining prefix. */
+            }
+            if ((!memcmp(connection->prefix, "HTTP/1.", 7) &&
+                 (connection->prefix[7] == '0' || connection->prefix[7] == '1')) ||
+                !memcmp(connection->prefix, "EVENT/1.", 8)) {
+                connection->reverse_stream = true;
+                connection->request_started_ms = 0;
+                return;
+            }
+            connection->request = http_request_init();
+            if (!connection->request) {
+                httpd_remove_connection(httpd, connection, 0);
+                return;
+            }
+            connection->prefix_checked = true;
+            int consumed = http_request_add_data(connection->request, connection->prefix,
+                                                  (int) sizeof(connection->prefix));
+            if (consumed != sizeof(connection->prefix) || http_request_has_error(connection->request)) {
+                httpd_remove_connection(httpd, connection, 0);
+                return;
+            }
+            if (offset == datalen) {
+                return;
+            }
+        }
+
+        int consumed = http_request_add_data(connection->request, data + offset, datalen - offset);
+        if (consumed < 0 || http_request_has_error(connection->request)) {
+            logger_log(httpd->logger, LOGGER_ERR, "httpd request rejected: %s: %s",
+                       http_request_get_error_name(connection->request),
+                       http_request_get_error_description(connection->request));
+            httpd_remove_connection(httpd, connection, 0);
+            return;
+        }
+        offset += consumed;
+        if (!http_request_is_complete(connection->request)) {
+            if (!consumed) {
+                httpd_remove_connection(httpd, connection, 0);
+                return;
+            }
+            continue;
+        }
+
+        http_response_t *response = NULL;
+        httpd->callbacks.conn_request(connection->user_data, connection->request, &response);
+        http_request_destroy(connection->request);
+        connection->request = NULL;
+        connection->prefix_length = 0;
+        connection->prefix_checked = false;
+        connection->request_started_ms = 0;
+        if (response) {
+            int response_length = 0;
+            const char *response_data = http_response_get_data(response, &response_length);
+            bool disconnect = http_response_get_disconnect(response) || connection->pending_remove;
+            /* A teardown handler may mark its own connection. Preserve its
+               final reply, then close once those bytes have been sent. */
+            connection->pending_remove = 0;
+            int queued = httpd_queue_data(httpd, connection->socket_fd, response_data, response_length);
+            http_response_destroy(response);
+            if (queued < 0) {
+                httpd_remove_connection(httpd, connection, 0);
+                return;
+            }
+            connection->close_after_write = disconnect;
+            if (disconnect) {
+                return;
+            }
+        } else {
+            logger_log(httpd->logger, LOGGER_WARNING, "httpd didn't get response");
+        }
+    }
+}
