+        connection->output_offset = 0;
+        char *output = realloc(connection->output, pending + (size_t) datalen);
+        if (!output) {
+            connection->pending_remove = 1;
+            return -1;
+        }
+        memcpy(output + pending, data, (size_t) datalen);
+        connection->output = output;
+        connection->output_length = pending + (size_t) datalen;
+        if (!pending) {
+            connection->output_progress_ms = httpd_now_ms();
+        }
+        return 0;
+    }
