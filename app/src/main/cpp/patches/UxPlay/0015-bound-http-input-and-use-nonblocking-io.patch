+/* Bound network work and memory without expiring idle established sessions. */
+#define HTTPD_IO_TIMEOUT_MS 30000U
+#define HTTPD_MAX_PENDING_OUTPUT HTTP_REQUEST_MAX_WIRE_SIZE
+
+static uint64_t
+httpd_now_ms(void)
+{
+#if defined(WIN32)
+    return (uint64_t) GetTickCount64();
+#else
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) == 0) {
+        return (uint64_t) now.tv_sec * 1000U + (uint64_t) now.tv_nsec / 1000000U;
+    }
+    struct timeval fallback;
+    gettimeofday(&fallback, NULL);
+    return (uint64_t) fallback.tv_sec * 1000U + (uint64_t) fallback.tv_usec / 1000U;
+#endif
+}
+
+static int
+httpd_nonblocking(int fd)
+{
+#if defined(WIN32)
+    unsigned long enabled = 1;
+#else
+    int enabled = 1;
+    if (fd < 0 || fd >= FD_SETSIZE) {
+        return -1;
+    }
+#endif
+#ifdef SO_NOSIGPIPE
+    int no_sigpipe = 1;
+    setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof(no_sigpipe));
+#endif
+    return IOCTLSOCKET(fd, FIONBIO, &enabled);
+}
+
+static bool
+httpd_retry_later(int error)
+{
+    return error == SOCKET_ERRORNAME(EAGAIN) || error == SOCKET_ERRORNAME(EWOULDBLOCK) ||
+           error == SOCKET_ERRORNAME(EINTR);
+}
