diff --git a/lib/httpd.h b/lib/httpd.h
--- a/lib/httpd.h
+++ b/lib/httpd.h
@@ -39,6 +39,8 @@
 typedef struct httpd_callbacks_s httpd_callbacks_t;
 bool httpd_nohold(httpd_t *httpd);
 void httpd_remove_known_connections(httpd_t *httpd);
+/* Thread-safe request; connection teardown runs on the HTTP worker. */
+void httpd_request_disconnect_clients(httpd_t *httpd);
 void httpd_remove_connections_by_type(httpd_t *httpd, connection_type_t type);
 
 int httpd_set_connection_type (httpd_t *http, void *user_data, connection_type_t type);
diff --git a/lib/httpd.c b/lib/httpd.c
--- a/lib/httpd.c
+++ b/lib/httpd.c
@@ -58,6 +58,7 @@
     /* These variables only edited mutex locked */
     int running;
     int joined;
+    int disconnect_clients_requested;
     thread_handle_t thread;
     mutex_handle_t run_mutex;
 
@@ -335,6 +336,15 @@
 }
 
 void
+httpd_request_disconnect_clients(httpd_t *httpd) {
+    MUTEX_LOCK(httpd->run_mutex);
+    if (httpd->running) {
+        httpd->disconnect_clients_requested = 1;
+    }
+    MUTEX_UNLOCK(httpd->run_mutex);
+}
+
+void
 httpd_remove_known_connections(httpd_t *httpd) {
     for (int i = 0; i < httpd->max_connections; i++) {
         http_connection_t *connection = &httpd->connections[i];
@@ -378,7 +388,19 @@
             MUTEX_UNLOCK(httpd->run_mutex);
             break;
         }
+        int disconnect_clients = httpd->disconnect_clients_requested;
+        httpd->disconnect_clients_requested = 0;
         MUTEX_UNLOCK(httpd->run_mutex);
+        if (disconnect_clients) {
+            /* Do not touch listening sockets or discovery; only end current sessions. */
+            /* Pairing/control sockets may still have UNKNOWN type. They belong to
+               the dismissed session too and must not keep its client count alive. */
+            for (int i = 0; i < httpd->max_connections; i++) {
+                if (httpd->connections[i].connected) {
+                    httpd->connections[i].pending_remove = 1;
+                }
+            }
+        }
 
         /* Set timeout value to 5ms */
         tv.tv_sec = 1;
