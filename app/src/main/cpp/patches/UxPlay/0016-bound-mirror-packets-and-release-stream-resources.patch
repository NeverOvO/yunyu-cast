+
+/* Bound a single compressed frame, not the negotiated video resolution. */
+#define MIRROR_MAX_PAYLOAD_SIZE (16U * 1024U * 1024U)
+
+/* Validate the complete parameter-set layout before the parser below reads or
+ * copies any variable-length field. Lengths on the wire are unsigned. */
+static bool
+mirror_codec_payload_valid(unsigned char *payload, int size)
+{
+    if (size < 8) return false;
+    if (!memcmp(payload + 4, "hvc1", 4)) {
+        int offset = 0x75;
+        for (int i = 0; i < 3; i++) {
+            if (offset > size || size - offset < 5) return false;
+            unsigned char *entry = payload + offset;
+            if (entry[0] != 0xa0 + i || entry[1] != 0 ||
+                entry[2] != 1 || entry[3] != 0) return false;
+            int length = byteutils_get_short_be(entry, 3);
+            offset += 5;
+            if (length < 2 || length > size - offset) return false;
+            offset += length;
+        }
+        return true;
+    }
+    if (size < 11) return false;
+    int sps_size = byteutils_get_short_be(payload, 6);
+    if (sps_size < 1 || sps_size > size - 11) return false;
+    int pps_size = byteutils_get_short_be(payload, sps_size + 9);
+    return pps_size >= 1 && pps_size <= size - sps_size - 11;
+}
